---
// A film recorded from the live site, as on Cuberto's work cards: the poster shows at
// rest, main.ts plays the film on hover (in view on touch screens) and pauses it on
// leave. Optionally a copy of the site's time-of-day slider follows the film's clock.
export type Film = {
  mp4: string;
  poster: string;
  /**
   * The film's time of day: it plays forward over `half` seconds, then backwards. Along a
   * sine-eased progress `keys` map progress (0..1) to hours, exactly as the film was
   * rendered. `range` is the slider's span, `dusk`/`night` the hours its icon changes at.
   */
  clock?: { half: number; keys: [number, number][]; range: [number, number]; dusk: number; night: number };
};
interface Props extends Film { color: string; ghost?: { src: string; aspect: number; width?: number } }
const { mp4, poster, clock, color, ghost } = Astro.props;

const start = clock?.keys[0][1] ?? 0;
const pad = (n: number) => String(n).padStart(2, '0');
const startClock = `${pad(Math.floor(start))}:${pad(Math.round((start % 1) * 60))}`;
const startK = clock ? ((start - clock.range[0]) / (clock.range[1] - clock.range[0])) * 100 : 0;
---
<div class="film" style={`--bg:${color}`} data-film data-clock={clock && JSON.stringify(clock)}>
  <video class="film__video" src={mp4} poster={poster} muted loop playsinline preload="none" aria-hidden="true"></video>
  {ghost && <span class="ghost" style={`--m:url(${ghost.src});--a:${ghost.aspect}${ghost.width ? `;--gw:${ghost.width}` : ''}`}></span>}
  {clock && (
    <div class="film__time" data-phase="day" style={`--k:${startK.toFixed(2)}%`} aria-hidden="true">
      <svg class="film__sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></svg>
      <svg class="film__moon" viewBox="0 0 24 24"><path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1z" /></svg>
      <span class="film__track"><i class="film__knob"></i></span>
      <b class="film__clock">{startClock}</b>
    </div>
  )}
</div>
