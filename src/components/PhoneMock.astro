---
// Two tilted phones on a coloured backdrop showing a real site. The tall page
// screenshot sits under the site's own header/bottom-bar strips; main.ts scrolls
// it while the card is hovered (or in view on touch screens). Sized in cqw so
// it scales with the card.
interface Props {
  page: string;
  pageHeight: number;
  top: string;
  bottom: string;
  starts: [number, number];
  color: string;
}
const { page, pageHeight, top, bottom, starts, color } = Astro.props;
// Each phone shows 844 CSS px of the page; it may scroll this far past its start
const travel = 1900;
const pct = (px: number) => ((px / pageHeight) * 100).toFixed(3);
---
<div class="mock" style={`--bg:${color}`} data-mock>
  <span class="mock__ring" style="--s:58.3"></span>
  <span class="mock__ring" style="--s:87.5"></span>
  <span class="mock__ring" style="--s:116.7"></span>
  {starts.map((start, i) => (
    <div class={`mock__phone mock__phone--${i}`}>
      <div class="mock__screen">
        <div class="mock__status" aria-hidden="true">
          <span>9:41</span>
          <span class="mock__icons"><i></i><i></i><i></i><i></i><b></b></span>
        </div>
        <div class="mock__view">
          <img
            class="mock__page" src={page} alt="" loading="lazy" decoding="async"
            data-start={pct(start)} data-end={pct(Math.min(start + travel, pageHeight - 844))}
            style={`transform: translateY(-${pct(start)}%)`}
          />
          <img class="mock__bar mock__bar--top" src={top} alt="" loading="lazy" />
          <img class="mock__bar mock__bar--bottom" src={bottom} alt="" loading="lazy" />
        </div>
        <span class="mock__island"></span>
      </div>
    </div>
  ))}
</div>
