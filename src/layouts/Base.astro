---
import '../styles/global.css';
import { ui, locales, localeLabels, localePath, defaultLocale, type Locale } from '../i18n/ui';
import { contact } from '../data/projects';
import Button from '../components/Button.astro';
import Mark from '../components/Mark.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const links = [
  ['#services', t.nav.services],
  ['#work', t.nav.work],
  ['#about', t.nav.about],
  ['#faq', t.nav.faq],
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jomi Studio</title>
    <meta name="description" content={t.meta} />
    <meta property="og:title" content="Jomi Studio" />
    <meta property="og:description" content={t.meta} />
    <meta property="og:image" content="/brand/jomi_avatar_light.svg" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/svg+xml" href="/brand/jomi_mark_light.svg" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={`https://jomistudio.tj${localePath(l)}`} />)}
    <link rel="alternate" hreflang="x-default" href={`https://jomistudio.tj${localePath(defaultLocale)}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />
    <noscript><style>.curtain{display:none}</style></noscript>
  </head>
  <body>
    <!-- Loader + page-transition curtain -->
    <div class="curtain" aria-hidden="true">
      <Mark ink="#F6F1E9" class="curtain__mark" />
    </div>

    <div class="cursor is-hidden" aria-hidden="true">
      <span class="cursor__dot">
        <span class="cursor__shape"></span>
        <span class="cursor__label"></span>
        <svg class="cursor__arrow" viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <svg class="cursor__play" viewBox="0 0 24 24"><path d="M8.5 5.8v12.4a.6.6 0 0 0 .9.5l10-6.2a.6.6 0 0 0 0-1l-10-6.2a.6.6 0 0 0-.9.5Z" fill="currentColor" /></svg>
      </span>
    </div>

    <header class="header">
      <div class="header__bar">
        <a href={localePath(lang)} class="header__logo" aria-label="Jomi Studio">
          <img class="header__logo-ink" src="/brand/jomi_logo_light.svg" alt="Jomi Studio" width="152" height="60" />
          <img class="header__logo-paper" src="/brand/jomi_logo_dark.svg" alt="" width="152" height="60" />
        </a>
        <nav class="header__nav">
          {links.map(([href, label]) => (
            <a href={href} class="header__link" data-section={href.slice(1)}>
              <span class="roll roll--grow" data-text={label}><span>{label}</span></span>
            </a>
          ))}
        </nav>
        <div class="header__right">
          <div class="langs">
            {locales.map((l) => <a href={localePath(l)} class:list={['langs__a', { active: l === lang }]} hreflang={l}>{localeLabels[l]}</a>)}
          </div>
          <Button href="#contact" label={t.nav.contact} class="header__cta" />
          <button class="burger" aria-label={t.menu} aria-expanded="false" aria-controls="menu">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Phone menu: a panel that drops down under the header -->
    <div class="menu" id="menu" aria-hidden="true">
      <div class="menu__panel">
        <span class="menu__label">{t.menu}</span>
        <nav class="menu__nav">
          {links.map(([href, label]) => <a href={href}><span>{label}</span></a>)}
        </nav>
        <Button href="#contact" label={t.nav.contact} class="menu__cta" />
        <div class="menu__foot">
          <div class="langs">
            {locales.map((l) => <a href={localePath(l)} class:list={['langs__a', { active: l === lang }]} hreflang={l}>{localeLabels[l]}</a>)}
          </div>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <a href={contact.instagram} target="_blank" rel="noopener">Instagram</a>
          {contact.telegram && <a href={contact.telegram} target="_blank" rel="noopener">Telegram</a>}
        </div>
      </div>
    </div>

    <main><slot /></main>
    <script>import '../scripts/main.ts';</script>
  </body>
</html>
